{
  "name": "mimodal",
  "version": "0.0.6",
  "description": "Lightweight all purpose modal written in vanilla js",
  "main": "dist/modal.js",
  "files": [
    "dist/mimodal.js",
    "dist/mimodal.css"
  ],
  "scripts": {
    "build": "webpack",
    "lint": "eslint ./src/js --ext .js || true",
    "test": "mocha --compilers js:babel-register && webpack --mode production --bail",
    "dev": "webpack serve --mode development"
  },
  "repositories": [
    {
      "type": "git",
      "url": "git@github.com:Draggable/mimodal.git"
    }
  ],
  "keywords": [
    "mini modal",
    "minimal modal",
    "mimodal",
    "vanilla js modal",
    "popup",
    "es6",
    "babel",
    "webpack"
  ],
  "author": "Kevin Chappell",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Draggable/mimodal/issues"
  },
  "homepage": "https://draggable.github.io/mimodal",
  "devDependencies": {
    "autoprefixer": "10.6.2",
    "babel-core": "^6.7.4",
    "babel-loader": "7.1.5",
    "babel-plugin-transform-runtime": "^6.6.0",
    "babel-preset-es2015": "^6.6.0",
    "babel-register": "^6.7.2",
    "chai": "^3.5.0",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "6.11.0",
    "eslint": "^2.6.0",
    "mini-css-extract-plugin": "2.10.2",
    "minimizer-webpack-plugin": "5.14.0",
    "mocha": "^2.4.5",
    "postcss": "8.5.32",
    "postcss-loader": "8.2.1",
    "sass": "1.108.0",
    "sass-loader": "13.3.3",
    "webpack": "5.112.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "6.1.0"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "module"
    },
    "env": {
      "browser": true,
      "node": true
    },
    "rules": {
      "no-console": 0,
      "new-cap": 0,
      "strict": 0,
      "no-underscore-dangle": 0,
      "no-use-before-define": 0,
      "eol-last": 0,
      "quotes": [
        2,
        "single"
      ]
    }
  }
}
